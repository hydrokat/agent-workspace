#!/bin/sh
set -eu

if [ -n "${STUB_GH_LOG:-}" ]; then
  printf '%s\n' "$*" >> "$STUB_GH_LOG"
fi

cmd="${1:-}"
sub="${2:-}"

case "$cmd $sub" in
  "auth status")
    exit 0
    ;;
  "pr list")
    printf '[]\n'
    exit 0
    ;;
  "repo view")
    printf '{"nameWithOwner":"acme/widget","defaultBranchRef":{"name":"main"}}\n'
    exit 0
    ;;
  "pr create")
    printf 'https://github.com/acme/widget/pull/42\n'
    exit 0
    ;;
  "pr view")
    printf '{"number":42,"url":"https://github.com/acme/widget/pull/42"}\n'
    exit 0
    ;;
  *)
    exit 0
    ;;
esac

    "name": "macos-arm64-bun-missing",
    "facts": {
      "bun": "missing",
      "ttyd": false,
      "needTerminal": false,
      "hostProblem": null,
      "tools": [
        "curl"
      ],
      "platform": {
        "os": "macos",
        "arch": "arm64",
        "libc": null
      }
    },
    "expected": {
      "supported": true,
      "unsupportedReason": null,
      "bunMissing": true,
      "bunBroken": false,
      "ttydMissing": false,
      "canAutoInstall": true,
      "autoInstall": [
        "bun"
      ],
      "manual": [
        {
          "dep": "bun",
          "commands": [
            "curl -fsSL https://bun.com/install | bash"
          ]
        }
      ],
      "script": {
        "name": "install-web-deps.sh",
        "content": "#!/usr/bin/env bash\n# tandem-web dependency installer for macOS arm64\n# Source: https://bun.com/docs/installation\nset -euo pipefail\n\necho \"==> Installing bun\"\ncurl -fsSL https://bun.com/install | bash\nexport BUN_INSTALL=\"${BUN_INSTALL:-$HOME/.bun}\"\nexport PATH=\"$BUN_INSTALL/bin:$PATH\"\nbun --version\n\necho \"==> Done\"\necho \"If bun is not found in a new shell, add these lines to your shell profile:\"\necho '  export BUN_INSTALL=\"$HOME/.bun\"'\necho '  export PATH=\"$BUN_INSTALL/bin:$PATH\"'\n"
      }
    }
  },

        "name": "install-web-deps.ps1",
        "content": "# tandem-web dependency installer for Windows x64\n# Source: https://bun.com/docs/installation\n$ErrorActionPreference = 'Stop'\n\nWrite-Host '==> Installing bun'\npowershell -c \"irm bun.sh/install.ps1|iex\"\n& \"$env:USERPROFILE\\.bun\\bin\\bun\" --version\n\nWrite-Host '==> Done'\nWrite-Host 'If bun is not found in a new terminal, add %USERPROFILE%\\.bun\\bin to your user PATH.'\n"
      }
    }

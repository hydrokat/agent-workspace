  "resize_commands": [
    [
      "bind-key",
      "-T",
      "tandem-resize",
      "Left",
      "resize-pane -L 5 ; switch-client -T tandem-resize"
    ],
    [
      "bind-key",
      "-T",
      "tandem-resize",
      "Right",
      "resize-pane -R 5 ; switch-client -T tandem-resize"
    ],
    [
      "bind-key",
      "-T",
      "tandem-resize",
      "Up",
      "resize-pane -U 2 ; switch-client -T tandem-resize"
    ],
    [
      "bind-key",
      "-T",
      "tandem-resize",
      "Down",
      "resize-pane -D 2 ; switch-client -T tandem-resize"
    ],
    [
      "bind-key",
      "-T",
      "tandem-resize",
      "=",
      "run-shell -b \"/usr/bin/python3 -m tandem reset-layout\" ; switch-client -T tandem-resize"
    ],
    [
      "bind-key",
      "-T",
      "tandem-resize",
      "Enter",
      "switch-client -T root"
    ],
    [
      "bind-key",
      "-T",
      "tandem-resize",
      "Escape",
      "switch-client -T root"
    ],

    "linux": "#[range=user|help]Alt+h Help#[norange]  #[range=user|add-agent]Ctrl+Alt+n New agent#[norange]  #[range=user|prev]Alt+Up Prev#[norange]  #[range=user|next]Alt+Down Next#[norange]  #[range=user|status]Alt+s Status#[norange]  #[range=user|queries]Alt+q Queries#[norange]  #[range=user|planner]Alt+1 Planners#[norange]  #[range=user|implementer]Alt+2 Implementers#[norange]  #[range=user|close-agent]Ctrl+Alt+w Close#[norange]  #[range=user|quit]Ctrl+Alt+x Quit#[norange]  #[range=user|restart]Ctrl+Alt+r Restart#[norange]  #[range=user|resize]Ctrl+Alt+z Resize#[norange]"

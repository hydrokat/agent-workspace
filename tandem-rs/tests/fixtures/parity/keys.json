  "default_keymap": [
    {
      "command": "display-popup -E -w 70% -h 70% \"{tandem} help\"",
      "description": "open this help",
      "group": "Help",
      "hint": "Help",
      "key": "Alt+h"
    },
    {
      "command": "display-popup -E -w 90% -h 90% \"{tandem} add-agent\"",
      "description": "add an agent",
      "group": "Agents",
      "hint": "New agent",
      "key": "Ctrl+Alt+n"
    },
    {
      "command": "run-shell -b \"{tandem} tab prev\"",
      "description": "previous agent in this column",
      "group": "Tabs",
      "hint": "Prev",
      "key": "Alt+Up"
    },
    {
      "command": "run-shell -b \"{tandem} tab next\"",
      "description": "next agent in this column",
      "group": "Tabs",
      "hint": "Next",
      "key": "Alt+Down"
    },
    {
      "command": "run-shell -b \"{tandem} focus status\"",
      "description": "focus the status window",
      "group": "Status",
      "hint": "Status",
      "key": "Alt+s"
    },
    {
      "command": "run-shell -b \"{tandem} focus queries\"",
      "description": "open the Queries tab",
      "group": "Status",
      "hint": "Queries",
      "key": "Alt+q"
    },
    {
      "command": "run-shell -b \"{tandem} focus planner\"",
      "description": "focus planners",
      "group": "Columns",
      "hint": "Planners",
      "key": "Alt+1"
    },
    {
      "command": "run-shell -b \"{tandem} focus implementer\"",
      "description": "focus implementers",
      "group": "Columns",
      "hint": "Implementers",
      "key": "Alt+2"
    },
    {
      "command": "confirm-before -p 'Close this agent? (y/n)' \"run-shell -b \\\"{tandem2} close-agent\\\"\"",
      "description": "close the focused agent (asks first)",
      "group": "Agents",
      "hint": "Close",
      "key": "Ctrl+Alt+w"
    },
    {
      "command": "run-shell -b \"{tandem} quit\"",
      "description": "exit menu: save and exit, detach, update tandem, discard",
      "group": "Quit",
      "hint": "Quit",
      "key": "Ctrl+Alt+x"
    },
    {
      "command": "run-shell -b \"{tandem} restart\"",
      "description": "restart an exited agent",
      "group": "Agents",
      "hint": "Restart",
      "key": "Ctrl+Alt+r"
    },
    {
      "command": "switch-client -T tandem-resize",
      "description": "resize mode: arrows resize the focused pane, = resets, Enter exits",
      "group": "Layout",
      "hint": "Resize",
      "key": "Ctrl+Alt+z"
    }
  ],
  "display_shortcut": {
    "darwin": {
      "Alt++": "Opt++",
      "Alt+-": "Opt+-",
      "Alt+1": "Opt+1",
      "Alt+2": "Opt+2",
      "Alt+Shift+Left": "Opt+Shift+Left",
      "Alt+h": "Opt+h",
      "Alt+q": "Opt+q",
      "Ctrl+Alt+z": "Ctrl+Opt+z",
      "Ctrl+c": "Ctrl+c",
      "Shift+Up": "Shift+Up"
    },
    "linux": {
      "Alt++": "Alt++",
      "Alt+-": "Alt+-",
      "Alt+1": "Alt+1",
      "Alt+2": "Alt+2",
      "Alt+Shift+Left": "Alt+Shift+Left",
      "Alt+h": "Alt+h",
      "Alt+q": "Alt+q",
      "Ctrl+Alt+z": "Ctrl+Alt+z",
      "Ctrl+c": "Ctrl+c",
      "Shift+Up": "Shift+Up"
    }
  },
  "help_lines": {
    "darwin": [
      "tandem keys (planners = left column, implementers = right column)",
      "",
      "Global (tmux)",
      "  Help      Opt+h        open this help",
      "  Agents    Ctrl+Opt+n   add an agent",
      "            Ctrl+Opt+w   close the focused agent (asks first)",
      "            Ctrl+Opt+r   restart an exited agent",
      "  Tabs      Opt+Up       previous agent in this column",
      "            Opt+Down     next agent in this column",
      "  Status    Opt+s        focus the status window",
      "            Opt+q        open the Queries tab",
      "  Columns   Opt+1        focus planners",
      "            Opt+2        focus implementers",
      "  Quit      Ctrl+Opt+x   exit menu: save and exit, detach, update tandem, discard",
      "  Layout    Ctrl+Opt+z   resize mode: arrows resize the focused pane, = resets, Enter exits",
      "",
      "Status & Queries window",
      "  Status    Tab          switch between the Status and Queries tabs",
      "            Opt+r        refresh the status now",
      "            Opt+g        go to the highlighted or asking agent's pane",
      "  Queries   Enter        answer the selected open question",
      "            1-9          fill the answer with a numbered option",
      "            Ctrl+S       send the answer",
      "            Opt+w        mark the selected question withdrawn",
      "            Esc          clear the draft and return to the list",
      "",
      "Launch / add-agent wizard",
      "  Model     Opt+f        focus the model filter",
      "  Summary   Opt+a        add another agent",
      "            Opt+d        delete the highlighted agent",
      "            Shift+L      launch all configured agents",
      "            Esc          back or cancel",
      "",
      "Mouse",
      "            click a status-bar hint = press its key",
      "            click a column title to pick one of its agents from a menu",
      "            right-click a pane = context menu (focus, restart, close, new agent, \u2026)",
      "            click a pane to focus it; drag a border to resize; scroll wheel scrolls",
      "  Resize    Ctrl+Opt+z then arrows (\u2190\u2192 5 columns, \u2191\u2193 2 rows) on the focused pane; = resets; Enter exits",
      "  Custom    set TANDEM_KEYS=\"help=Ctrl+Opt+h,quit=Ctrl+Opt+q\" (each needs at least one modifier)",
      "  Detach    your agents keep running; run `tandem` again to re-attach"
    ],
    "linux": [
      "tandem keys (planners = left column, implementers = right column)",
      "",
      "Global (tmux)",
      "  Help      Alt+h        open this help",
      "  Agents    Ctrl+Alt+n   add an agent",
      "            Ctrl+Alt+w   close the focused agent (asks first)",
      "            Ctrl+Alt+r   restart an exited agent",
      "  Tabs      Alt+Up       previous agent in this column",
      "            Alt+Down     next agent in this column",
      "  Status    Alt+s        focus the status window",
      "            Alt+q        open the Queries tab",
      "  Columns   Alt+1        focus planners",
      "            Alt+2        focus implementers",
      "  Quit      Ctrl+Alt+x   exit menu: save and exit, detach, update tandem, discard",
      "  Layout    Ctrl+Alt+z   resize mode: arrows resize the focused pane, = resets, Enter exits",
      "",
      "Status & Queries window",
      "  Status    Tab          switch between the Status and Queries tabs",
      "            Alt+r        refresh the status now",
      "            Alt+g        go to the highlighted or asking agent's pane",
      "  Queries   Enter        answer the selected open question",
      "            1-9          fill the answer with a numbered option",
      "            Ctrl+S       send the answer",
      "            Alt+w        mark the selected question withdrawn",
      "            Esc          clear the draft and return to the list",
      "",
      "Launch / add-agent wizard",
      "  Model     Alt+f        focus the model filter",
      "  Summary   Alt+a        add another agent",
      "            Alt+d        delete the highlighted agent",
      "            Shift+L      launch all configured agents",
      "            Esc          back or cancel",
      "",
      "Mouse",
      "            click a status-bar hint = press its key",
      "            click a column title to pick one of its agents from a menu",
      "            right-click a pane = context menu (focus, restart, close, new agent, \u2026)",
      "            click a pane to focus it; drag a border to resize; scroll wheel scrolls",
      "  Resize    Ctrl+Alt+z then arrows (\u2190\u2192 5 columns, \u2191\u2193 2 rows) on the focused pane; = resets; Enter exits",
      "  Custom    set TANDEM_KEYS=\"help=Ctrl+Alt+h,quit=Ctrl+Alt+q\" (each needs at least one modifier)",
      "  Detach    your agents keep running; run `tandem` again to re-attach"
    ]

  "mouse_commands": [
    [
      "bind-key",
      "-n",
      "MouseDown1Status",
      "run-shell -b \"/usr/bin/python3 -m tandem click #{q:mouse_status_range}\""
    ],
    [
      "bind-key",
      "-n",
      "MouseDown3Pane",
      "select-pane -t = ; display-menu -O -T tandem -t = -x M -y M \"Focus this pane\" f \"select-pane -t =\" \"#{?pane_dead,,-}Restart agent\" r \"run-shell -b \\\"/usr/bin/python3 -m tandem restart\\\"\" \"Close agent\u2026\" w \"confirm-before -p 'Close this agent? (y/n)' \\\"run-shell -b \\\\\\\"/usr/bin/python3 -m tandem close-agent\\\\\\\"\\\"\" \"\" \"New agent\" n \"display-popup -E -w 90% -h 90% \\\"/usr/bin/python3 -m tandem add-agent\\\"\" \"Status\" s \"run-shell -b \\\"/usr/bin/python3 -m tandem focus status\\\"\" \"Queries\" q \"run-shell -b \\\"/usr/bin/python3 -m tandem focus queries\\\"\" \"Resize mode\" z \"switch-client -T tandem-resize\" \"Help\" h \"display-popup -E -w 70% -h 70% \\\"/usr/bin/python3 -m tandem help\\\"\""
    ],
    [
      "bind-key",
      "-n",
      "MouseDown1Border",
      "select-pane -t = ; run-shell -b \"/usr/bin/python3 -m tandem click-tab #{q:pane_id}\""
    ],
    [
      "unbind-key",
      "-q",
      "-n",
      "MouseDown3Status"
    ],
    [
      "unbind-key",
      "-q",
      "-n",
      "MouseDown3StatusLeft"
    ],
    [
      "unbind-key",
      "-q",
      "-n",
      "M-MouseDown3Pane"
    ]
  ],

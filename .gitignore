# Ignore all by default
*

# Keep gitignore itself
!.gitignore

# Keep root base docs
!AGENTS.md
!README.md
!CHANGELOG.md
!WORKFLOW.md

# Keep base source directories
!.agents/
!.agents/agents/
!.agents/agents/**
!.agents/skills/
!.agents/skills/**

# Keep knowledgebase and specs directory
!knowledgebase/
!knowledgebase/**
!specs/
!specs/**

# Ignore generated compatibility outputs
.claude/
.gemini/

# Ignore secrets and local junk
.env
.env.*
.DS_Store
